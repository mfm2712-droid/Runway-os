{
  "name": "Runway OS",
  "short_name": "Runway",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#05050a",
  "theme_color": "#05050a",
  "icons": [
    { "src": "/app-icon.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app-icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add Expense",
      "short_name": "Add",
      "url": "/app?action=add",
      "icons": [{ "src": "/app-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "Scan Receipt",
      "short_name": "Scan",
      "url": "/app?action=scan",
      "icons": [{ "src": "/app-icon.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "media", "accept": ["image/*"] }]
    }
  }
}
