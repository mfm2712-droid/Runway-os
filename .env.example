# Copy to .env.local for `vercel dev`, or set in your Vercel project's
# Environment Variables for production. Never commit real values.
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-4-5 if unset.
ANTHROPIC_MODEL=

# Stripe — see README.md "Stripe setup" for the full walkthrough.
# Dashboard → Developers → API keys. Use sk_test_... while testing.
STRIPE_SECRET_KEY=
# Dashboard → Products → (product) → each variant's Price ID (price_...).
# Not secret, but keeping them here too avoids drift with the checkout code.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Dashboard → Developers → Webhooks → (endpoint) → Signing secret.
# Only needed once you've added the /api/stripe-webhook endpoint there.
STRIPE_WEBHOOK_SECRET=

# Optional — enables a hand-issued "support access code" in the paywall as
# a Pro-access fallback, verified server-side (api/verify-support-token.ts).
# Leave unset to disable manual support access entirely.
SUPPORT_ACCESS_TOKEN=

# Not wired into the build today. index.html's Open Graph/Twitter meta tags
# (og:image, og:url, twitter:image) are the only hardcoded-host spots in the
# app — the OG spec requires them to be absolute URLs. If you want moving to
# a custom domain to be a one-line change instead of hand-editing those 3
# lines, wire index.html to use `%VITE_PUBLIC_URL%` (Vite replaces %ENV_NAME%
# placeholders in index.html from any VITE_-prefixed env var at build time)
# and set this here / in Vercel's Environment Variables.
# VITE_PUBLIC_URL=https://your-domain.example
