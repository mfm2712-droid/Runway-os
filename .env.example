# Copy to .env.local for `vercel dev`, or set in your Vercel project's
# Environment Variables for production. Never commit real values.
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-4-5 if unset.
ANTHROPIC_MODEL=

# Stripe — see README.md "Stripe setup" for the full walkthrough.
# Dashboard → Developers → API keys. Use sk_test_... while testing.
STRIPE_SECRET_KEY=
# Dashboard → Products → (product) → each variant's Price ID (price_...).
# Not secret, but keeping them here too avoids drift with the checkout code.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Dashboard → Developers → Webhooks → (endpoint) → Signing secret.
# Only needed once you've added the /api/stripe-webhook endpoint there.
STRIPE_WEBHOOK_SECRET=
